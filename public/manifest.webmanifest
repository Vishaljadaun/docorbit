{
  "id": "./",
  "name": "DocOrbit — PDF, OCR & Media Tools",
  "short_name": "DocOrbit",
  "description": "Document editing, OCR, AI tools, and public media downloads in one convenient workspace.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111D33",
  "theme_color": "#111D33",
  "lang": "en",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "./icons/docorbit-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/docorbit-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/docorbit-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./?source=share",
    "method": "GET",
    "params": {
      "title": "shared_title",
      "text": "shared_text",
      "url": "shared_url"
    }
  }
}
