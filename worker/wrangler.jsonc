{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docorbit-ai-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://vishaljadaun.github.io"
  },
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "SHARED_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
}
